# Copy to .env or set these on your host (Render → Environment). Never commit real values.
PORT=8080
DATA_DIR=/data                      # a persistent disk
ADMIN_KEY=                          # 16+ random characters: unlocks /admin and moderation
GOOGLE_CLIENT_IDS=                  # Web OAuth client id(s) for Sign in with Google
ADMOB_PUBLISHER_ID=                 # pub-XXXXXXXXXXXXXXXX, served at /app-ads.txt
ALLOWED_ORIGIN=*                    # tighten to your site if you like
